# Copy to .env.local for local dev. Never commit real values.

# Public base URL of the site, no trailing slash. Used for absolute links in share previews.
SITE_URL=https://expeditions-gold.vercel.app

# Optional, local dev only: read a saved Purdue API response instead of the live API.
# PURDUE_FIXTURE_FILE=fixtures/purdue-posts.json
# Optional, local dev only: read saved Open-Meteo responses (weather.json, marine.json) from this folder.
# OPEN_METEO_FIXTURE_DIR=fixtures/open-meteo   (live captures from Oct 14, 2026)
