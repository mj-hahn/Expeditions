# Copy to .env.local for local dev. Never commit real values.

# Public base URL of the site, no trailing slash (also a GitHub Actions secret)
SITE_URL=https://earhart.mjhahn.com

# Long random string. Bearer token for /api/check-dispatches (also a GitHub Actions secret)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Resend (https://resend.com) API key and sender details
RESEND_API_KEY=
ALERT_FROM="Taraia Watch <updates@earhart.mjhahn.com>"
ALERT_REPLY_TO=
# Comma-separated list. Each recipient gets a separate email.
ALERT_RECIPIENTS=
# Where ?test=1 sends the sample email
ADMIN_EMAIL=

# Upstash Redis REST credentials. The Vercel Marketplace integration injects these
# automatically; either naming style works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
